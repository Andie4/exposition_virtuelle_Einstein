RewriteEngine On
RewriteBase /api/
RewriteRule ^api_controller/?$ api_controller.php [NC,L]

# Réécriture des URLs pour gérer les requêtes API
RewriteRule ^api/([a-zA-Z0-9_-]+)/?$ api_controller.php?type=$1 [QSA,L]
RewriteRule ^api/([a-zA-Z0-9_-]+)/([0-9]+)/?$ api_controller.php?type=$1&id=$2 [QSA,L]
